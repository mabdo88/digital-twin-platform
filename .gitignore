.zig-cache/
zig-out/
benchmark-results/
graphify-out/
*.ifc

# Run outputs from dt.exe --out <dir> — regenerable artifacts, never tracked.
smoke-out*/
hospital-out*/
house-results/
benchmark-results-office/

# Run outputs from older commits — same category as smoke-out*/house-results.
output/

# `zig build calibrate` output — regenerable, same category as
# benchmark-results/. Includes the exported CSV fixture (~30 MB).
calibration-results/

# Local copy of the DuckDB CLI for the optional calibration pass. A
# machine-local, platform-specific third-party binary: developers who want
# the pass download their own (see CLAUDE.md §7), and nothing in the build
# depends on it being here.
tools/

# subagent-driven-development scratch state (progress ledger, task briefs,
# review packages) — never tracked.
.superpowers/

# AI coding-tool local config/scratch — machine-local, not project docs.
# (.cascade/digital-twin/, CLAUDE.md, AGENT.md are kept: cross-referenced
# from README.md as the project's actual rules/status documentation.)
.claude/
.windsurf/
docs/superpowers/
